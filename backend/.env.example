# ─────────────────────────────────────────────────────────────
# Guitar AI — backend configuration
# Copy this file to  backend/.env  and edit what you need.
#   cp .env.example .env
# Nothing here costs money. Leave GEMINI_API_KEY empty and the app
# still works completely.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true
# Comma-separated list of frontend origins. "*" allows everything (fine for local dev).
CORS_ORIGINS=*

# ── Upload limits ────────────────────────────────────────────
MAX_UPLOAD_MB=200
# 900 seconds = 15 minutes of audio. Longer files are slow on CPU-only machines.
MAX_DURATION_SEC=900

# ── Analysis ─────────────────────────────────────────────────
SAMPLE_RATE=44100

# ── Optional: Google Gemini (free tier) ──────────────────────
# Get a key at https://aistudio.google.com/apikey  (no credit card needed).
# Leave empty to use the free local data-derived explanations instead.
GEMINI_API_KEY=
GEMINI_ENABLED=true
# Current free-tier model ids (verified Nov 2026). The app tries them in order.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_TIMEOUT_SEC=60

# ── Optional: heavy ML models ────────────────────────────────
# Set to false to force the built-in (lighter) engines.
USE_BASIC_PITCH=true
USE_DEMUCS=true
# htdemucs_6s = 6 stems (vocals, drums, bass, GUITAR, piano, other).
# This is the model that gives a real guitar stem.
DEMUCS_MODEL=htdemucs_6s
DEMUCS_FALLBACK_MODEL=htdemucs
DEMUCS_DEVICE=cpu
# shifts=1 is ~5x faster; 5 gives the best quality. Use 1 while developing.
DEMUCS_SHIFTS=1
DEMUCS_JOBS=1

# ── URL fetching (paste a link instead of a file) ────────────
# ON by default. Fetches PUBLIC media only, via yt-dlp.
# Age gates, private/members-only items, region or copyright blocks and
# "confirm you're not a bot" checks are NEVER bypassed — the app reports them.
# Use it on your own recordings or material you have permission to analyse.
ENABLE_URL_FETCH=true
# Longest clip we will pull from a link (seconds).
URL_MAX_DURATION_SEC=900
# Optional: your own cookies.txt for platforms that need a logged-in session.
# Export it from your browser with an extension like "Get cookies.txt LOCALLY".
# Leave empty for anonymous/public access.
YTDLP_COOKIES_FILE=
# YouTube player clients, tried in order (some work where others are blocked).
YTDLP_PLAYER_CLIENTS=tv_embedded,ios,web_safari,android_vr,mweb,web
YTDLP_FORMAT=bestaudio/best

# ── Housekeeping ─────────────────────────────────────────────
KEEP_TEMP_HOURS=24
